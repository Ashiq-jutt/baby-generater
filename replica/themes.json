{
  "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text. kind is complaint (something users hate) or request (something users want that is missing). Edit freely: add the app category's own words (for a booking app: double booking, time zone, no-show).",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
  ],
  "themes": [
    {
      "id": "pricing",
      "label": "Price and paywalls",
      "kind": "complaint",
      "patterns": [
        "\\bexpensive\\b",
        "\\boverpriced\\b",
        "\\bpric(e|es|ey|ing)\\b",
        "\\bpaywall",
        "\\bsubscription\\b",
        "\\bper (month|seat|user)\\b",
        "\\bfree (plan|tier|version)\\b",
        "\\bupgrade to\\b",
        "\\bpremium\\b",
        "\\bnot worth\\b",
        "\\bcost(s|ly)?\\b"
      ]
    },
    {
      "id": "billing",
      "label": "Billing, cancelling and refunds",
      "kind": "complaint",
      "patterns": [
        "\\bcharged\\b",
        "\\brefund",
        "\\bcancel(l?ing|l?ed|lation)?\\b",
        "\\bauto.?renew",
        "\\bhidden (fee|charge)",
        "\\bbilling\\b",
        "\\bscam\\b",
        "\\bcredit card\\b"
      ]
    },
    {
      "id": "bugs",
      "label": "Bugs and crashes",
      "kind": "complaint",
      "patterns": [
        "\\bcrash(es|ed|ing)?\\b",
        "\\bbugs?\\b",
        "\\bbuggy\\b",
        "\\bglitch",
        "\\bfreez(e|es|ing)\\b",
        "\\bbroken\\b",
        "\\b(doesn'?t|does not|stopped) work",
        "\\bnot working\\b",
        "\\berror\\b"
      ]
    },
    {
      "id": "performance",
      "label": "Slow, laggy, heavy",
      "kind": "complaint",
      "patterns": [
        "\\bslow\\b",
        "\\blag(gy|s)?\\b",
        "\\bloading\\b",
        "\\btakes forever\\b",
        "\\bbattery\\b",
        "\\bsluggish\\b",
        "\\bheavy\\b"
      ]
    },
    {
      "id": "data",
      "label": "Sync and lost data",
      "kind": "complaint",
      "patterns": [
        "\\bsync(ing|s|ed)?\\b",
        "\\blost (my|all)\\b",
        "\\bdisappear",
        "\\bdata loss\\b",
        "\\bwiped\\b",
        "\\bbackup\\b",
        "\\bduplicat"
      ]
    },
    {
      "id": "ux",
      "label": "Confusing or clunky to use",
      "kind": "complaint",
      "patterns": [
        "\\bconfus",
        "\\bhard to (use|find|navigate|understand)\\b",
        "\\bcomplicated\\b",
        "\\bcluttered\\b",
        "\\bunintuitive\\b",
        "\\bnot intuitive\\b",
        "\\bclunky\\b",
        "\\btoo many (steps|clicks|taps)\\b",
        "\\blearning curve\\b",
        "\\bcan'?t find\\b"
      ]
    },
    {
      "id": "support",
      "label": "Support that does not answer",
      "kind": "complaint",
      "patterns": [
        "\\bcustomer (service|support)\\b",
        "\\bsupport (team|is|was)\\b",
        "\\bno (response|reply)\\b",
        "\\bnever (replied|responded|heard back)\\b",
        "\\bticket\\b",
        "\\bchat ?bot\\b"
      ]
    },
    {
      "id": "account",
      "label": "Login and account problems",
      "kind": "complaint",
      "patterns": [
        "\\blog ?in\\b",
        "\\bsign ?in\\b",
        "\\bpassword\\b",
        "\\blocked out\\b",
        "\\bverification\\b",
        "\\b2fa\\b",
        "\\bdelete (my )?account\\b"
      ]
    },
    {
      "id": "notifications",
      "label": "Notifications and spam",
      "kind": "complaint",
      "patterns": [
        "\\bnotification",
        "\\bspam",
        "\\btoo many emails\\b",
        "\\bpush\\b",
        "\\breminders?\\b"
      ]
    },
    {
      "id": "ads",
      "label": "Ads",
      "kind": "complaint",
      "patterns": [
        "\\bads\\b",
        "\\badvert",
        "\\bad.?supported\\b",
        "\\bpop.?ups?\\b"
      ]
    },
    {
      "id": "updates",
      "label": "A redesign or update made it worse",
      "kind": "complaint",
      "patterns": [
        "\\b(new|latest|recent) (update|version|design)\\b",
        "\\bredesign",
        "\\bused to be\\b",
        "\\bbring back\\b",
        "\\bsince the update\\b"
      ]
    },
    {
      "id": "privacy",
      "label": "Privacy and permissions",
      "kind": "complaint",
      "patterns": [
        "\\bprivacy\\b",
        "\\btracking\\b",
        "\\bsell(s|ing)? (my )?data\\b",
        "\\bpermissions?\\b",
        "\\bcreepy\\b"
      ]
    },
    {
      "id": "integrations",
      "label": "Integrations, import and export",
      "kind": "request",
      "patterns": [
        "\\bintegrat",
        "\\bzapier\\b",
        "\\bgoogle (calendar|sheets|drive)\\b",
        "\\boutlook\\b",
        "\\bslack\\b",
        "\\bapi\\b",
        "\\bexport\\b",
        "\\bimport\\b",
        "\\bcsv\\b",
        "\\bwebhook"
      ]
    },
    {
      "id": "platforms",
      "label": "Platforms, offline and mobile",
      "kind": "request",
      "patterns": [
        "\\boffline\\b",
        "\\bandroid\\b",
        "\\bipad\\b",
        "\\btablet\\b",
        "\\bdesktop app\\b",
        "\\bmac app\\b",
        "\\bwindows\\b",
        "\\bmobile (app|version)\\b",
        "\\bweb version\\b"
      ]
    },
    {
      "id": "customisation",
      "label": "Customisation and control",
      "kind": "request",
      "patterns": [
        "\\bcustomi[sz]",
        "\\bdark mode\\b",
        "\\btheme\\b",
        "\\bbranding\\b",
        "\\bwhite.?label\\b",
        "\\btemplates?\\b",
        "\\bsettings?\\b",
        "\\boption to\\b"
      ]
    },
    {
      "id": "collaboration",
      "label": "Teams and sharing",
      "kind": "request",
      "patterns": [
        "\\bteam(s|mates?)?\\b",
        "\\bshar(e|ing)\\b",
        "\\bcollaborat",
        "\\bmultiple (users|accounts|people)\\b",
        "\\broles?\\b",
        "\\bpermissions for\\b"
      ]
    },
    {
      "id": "likeness",
      "label": "Result looks nothing like the photo",
      "kind": "complaint",
      "patterns": [
        "\\blook(s|ed)? nothing like\\b",
        "\\bdoesn'?t look like\\b",
        "\\bnot (even )?close\\b",
        "\\bresembl",
        "\\blikeness\\b",
        "\\brandom (baby|face|picture|stock)\\b",
        "\\bgeneric\\b",
        "\\bsame (baby|face|photo) (for )?every",
        "\\bstock photo\\b",
        "\\bfake\\b",
        "\\bnot accurate\\b",
        "\\binaccurate\\b",
        "\\bwrong (skin|eye|hair|race|ethnic)"
      ]
    },
    {
      "id": "quality",
      "label": "Output quality: blurry, distorted, creepy",
      "kind": "complaint",
      "patterns": [
        "\\bblurry\\b",
        "\\bpixelated\\b",
        "\\blow (quality|res)",
        "\\bdistort",
        "\\bdeformed\\b",
        "\\bcreepy\\b",
        "\\bugly\\b",
        "\\bweird\\b",
        "\\bhorrible\\b",
        "\\bterrible (quality|results?)\\b",
        "\\bawful\\b",
        "\\bmorph",
        "\\bglitchy face"
      ]
    },
    {
      "id": "credits",
      "label": "Credits burned on bad results, no retry",
      "kind": "complaint",
      "patterns": [
        "\\bcredits?\\b",
        "\\bcoins?\\b",
        "\\bdiamonds?\\b",
        "\\btokens?\\b",
        "\\bran out\\b",
        "\\bused up\\b",
        "\\bone (try|attempt|generation)\\b",
        "\\bwaste(d)? (my )?(money|credits)\\b",
        "\\bno retry\\b",
        "\\bgenerations? left\\b"
      ]
    },
    {
      "id": "trial",
      "label": "Free trial / paywall tricks",
      "kind": "complaint",
      "patterns": [
        "\\bfree trial\\b",
        "\\b3.?day (trial|free)\\b",
        "\\bbait\\b",
        "\\bmislead",
        "\\btrick(ed|s|ing|y)?\\b",
        "\\bforced to pay\\b",
        "\\bmake you pay\\b",
        "\\bpay (first|before)\\b",
        "\\bhidden\\b",
        "\\brip ?off\\b",
        "\\bsham\\b"
      ]
    },
    {
      "id": "watermark",
      "label": "Watermarks on the video",
      "kind": "complaint",
      "patterns": [
        "\\bwatermark",
        "\\blogo on\\b",
        "\\bbranding on (the )?video\\b"
      ]
    },
    {
      "id": "waittime",
      "label": "Generation takes too long / stuck",
      "kind": "complaint",
      "patterns": [
        "\\bstuck\\b",
        "\\bnever finish",
        "\\bprocessing\\b",
        "\\bqueue\\b",
        "\\bhours?\\b",
        "\\bstill waiting\\b",
        "\\btakes? (so )?long\\b",
        "\\btimed? out\\b"
      ]
    },
    {
      "id": "voice",
      "label": "Voice, lipsync and audio",
      "kind": "request",
      "patterns": [
        "\\bvoice\\b",
        "\\blip.?sync",
        "\\bmy own voice\\b",
        "\\baudio\\b",
        "\\bsound\\b",
        "\\bmusic\\b",
        "\\blanguage\\b",
        "\\bspanish\\b",
        "\\bhindi\\b",
        "\\barabic\\b",
        "\\bdub"
      ]
    },
    {
      "id": "control",
      "label": "Control over the scene / prompt",
      "kind": "request",
      "patterns": [
        "\\bprompt\\b",
        "\\bchoose the\\b",
        "\\bselect (the )?(background|outfit|scene|style)\\b",
        "\\bmore (styles?|templates?|options?|poses?)\\b",
        "\\bedit the\\b",
        "\\bregenerate\\b",
        "\\blonger video\\b",
        "\\bduration\\b",
        "\\bseconds?\\b"
      ]
    }
  ]
}