# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
# Claude did not create any of these accounts - you do, and you paste the keys.

# ─── Supabase ────────────────────────────────────────────────────────────
# Project Settings -> API. The anon key is PUBLIC and safe in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 to use the real backend; anything else uses the in-memory fake.
EXPO_PUBLIC_USE_REAL_BACKEND=0

# ─── Server only. NEVER prefix these with EXPO_PUBLIC_ ───────────────────
# Supabase -> Project Settings -> API -> service_role.
# This key bypasses RLS. It belongs in Edge Function secrets only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Model provider ──────────────────────────────────────────────────────
# fal.ai -> Dashboard -> Keys. Billed per generation, so treat it as a
# payment credential. Get the real per-second price for Vidu Q3 Turbo at
# 540p before launch and put it in models.unit_cost_cents - architecture.md
# explains why that single number decides the business.
FAL_KEY=

# ─── Payments ────────────────────────────────────────────────────────────
# RevenueCat -> Project -> Integrations -> Webhooks. A shared bearer token
# you choose; the webhook compares it in constant time.
REVENUECAT_WEBHOOK_SECRET=

# Stripe (web top-up only; the stores handle in-app). TEST KEYS until deploy.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Jobs ────────────────────────────────────────────────────────────────
# Any long random string. pg_cron sends it as x-jobs-secret so the job
# endpoints are not reachable with a user token.
JOBS_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────
# Resend -> API Keys. Needs a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=

# ─── Misc ────────────────────────────────────────────────────────────────
# Comma-separated. The Edge Functions reject any other Origin.
ALLOWED_ORIGINS=http://localhost:8081
